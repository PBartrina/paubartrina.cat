{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3000/ca",
        "http://localhost:3000/ca/ara",
        "http://localhost:3000/ca/blog",
        "http://localhost:3000/ca/blog/cinc-mesos-de-bots-els-numeros",
        "http://localhost:3000/ca/uses",
        "http://localhost:3000/ca/cv",
        "http://localhost:3000/ca/contacte",
        "http://localhost:3000/ca/log",
        "http://localhost:3000/ca/about"
      ],
      "numberOfRuns": 2
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 194560 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 491520 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
